# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dayang_spa

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
PORT=3001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Majoo integration (optional — DISABLED by default).
# MAJOO_ENABLED=true requires BOTH MAJOO_BASE_URL and MAJOO_TOKEN, otherwise
# the server refuses to start (fail-fast). Keep false until the real API is
# available; false = MockMajooAdapter (no network calls to Majoo).
MAJOO_ENABLED=false
# MAJOO_BASE_URL=
# MAJOO_TOKEN=